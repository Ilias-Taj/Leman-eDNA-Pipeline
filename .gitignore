# ── Leman eDNA Pipeline .gitignore ──────────────────────────────────────────

# Local conda environment (recreate from environment.yml)
/env/

# Pipeline outputs (large, regenerable)
/out/*/barcode*/
/out/*/temp_clustering/
/out/*/merged/
/out/*/taxonomy/
/out/*/taxonomy_summary/
/out/*/blast_results/
/out/*/logs/
/out/*/unclassified/
/out/logs/

# Raw sequencing data (too large for git)
/data/*

# Reference databases (large binary files - rebuild with setup scripts)
/refs/*.udb
/refs/*.fasta
/refs/*.fasta.gz
/refs/minimap2_refs/
/refs/__pycache__/

# Pre-built tool binaries (download or build locally)
/tools/isONclust3/
/tools/minimap2-*/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# OS metadata
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
*.swp
*.swo
*~